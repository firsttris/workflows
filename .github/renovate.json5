// Renovate (GitHub App, https://github.com/apps/renovate): a pull request for each new release of
// what the shared workflows and actions run, plus the "Dependency Dashboard" issue listing what is
// open. Every project calls these through @v1, so a pin here moves the CI of all of them: the
// actions the workflows use (one PR for all, majors apart), actionlint of the lint job, the Node
// of the VS Code publish job and the vsce/ovsx it publishes with. The Playwright image is not
// pinned here: actions/playwright-image reads it from each project's lockfile. This repository's
// own actions (firsttris/workflows/...@v1) are not tracked, they move with `move-tag.yml`.
// Check with `npx --package renovate renovate-config-validator .github/renovate.json5`.
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended"],
  enabledManagers: ["github-actions", "custom.regex"],
  timezone: "Europe/Berlin",
  labels: ["dependencies"],
  automerge: false,
  customManagers: [
    {
      // ACTIONLINT_VERSION in the lint job (the download script and the binary of that tag)
      customType: "regex",
      managerFilePatterns: ["/^\\.github/workflows/lint\\.yml$/"],
      matchStrings: ["ACTIONLINT_VERSION: (?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      depNameTemplate: "rhysd/actionlint",
      datasourceTemplate: "github-releases",
      extractVersionTemplate: "^v(?<version>\\d+\\.\\d+\\.\\d+)$",
    },
    {
      // vsce and ovsx, run with npx in the VS Code publish job
      customType: "regex",
      managerFilePatterns: ["/^\\.github/workflows/vscode-extension-publish\\.yml$/"],
      matchStrings: ["npx --yes (?<depName>@vscode/vsce|ovsx)@(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      datasourceTemplate: "npm",
    },
  ],
  packageRules: [
    {
      // The actions and workflows of this repository, moved by move-tag.yml
      matchPackageNames: ["firsttris/workflows", "firsttris/workflows/**"],
      enabled: false,
    },
    {
      // One PR for every action (a major one apart), so the workflows stay on the same generation
      matchManagers: ["github-actions"],
      matchDepTypes: ["action"],
      groupName: "GitHub Actions",
      prBodyNotes: [
        "Every project uses these workflows through `@v1`. Before merging: read the release notes of each major (inputs renamed or removed, a new Node runtime of the action); `docker/*` and `actions/upload-artifact`/`download-artifact` must stay on matching majors (the digest artifacts of `docker-release.yml`). The lint job runs actionlint and the apt-install cache test. After merging: try one caller (a docker release with `edge`, a screenshots run), then run **Actions → Move major tag** so the projects get it; a change that breaks callers needs a `v2` instead.",
      ],
    },
    {
      matchPackageNames: ["rhysd/actionlint"],
      sourceUrl: "https://github.com/rhysd/actionlint",
      prBodyNotes: [
        "A new actionlint may find new problems in the workflows; the lint job of this PR shows them.",
      ],
    },
    {
      // The Node of the publish job (setup-node's node-version, vsce and ovsx need >= 22) and the
      // two publishing CLIs in one PR
      matchDepNames: ["node", "@vscode/vsce", "ovsx"],
      groupName: "VS Code publish",
      prBodyNotes: [
        "Used by `vscode-extension-publish.yml` only; nothing here runs it before a release. Before merging: read the changelogs of vsce and ovsx (`publish --packagePath`, `--skip-duplicate`); check their `engines.node` against `node-version`. After merging: Move major tag, and watch the next extension release (vscode-jest-runner).",
      ],
    },
  ],
}
