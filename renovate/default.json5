// The shared Renovate settings of every project (Renovate GitHub App). A project takes them with
//   extends: ["github>firsttris/workflows//renovate/default.json5"]
// and adds its own rules for what it builds on (an engine, SnapRAID, ESPHome, Bun, Tauri, ...);
// its rules come after these and win. See "Renovate" in the README.
//
// - The ordinary packages (npm/Bun, Cargo, pip, Go, Deno, actions, images): minor and patch
//   updates once a month in one pull request per project, merged by Renovate itself once CI is
//   green; lock file maintenance in the same window.
// - Major updates only on request: they wait in the Dependency Dashboard issue until ticked.
// - Security fixes at once, outside the schedule, not merged by themselves.
// - A release is taken only after three days (most broken or hijacked releases are pulled by then).
// - A project's rule for what it builds on sets its own groupName, `schedule: ["at any time"]` and
//   `automerge: false`, so that upstream keeps its own pull request with its checklist.
// - A project whose pull requests run no CI sets `automerge: false` and
//   `lockFileMaintenance: { automerge: false }`: without checks nothing would stop a merge.
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended", ":dependencyDashboard"],
  timezone: "Europe/Berlin",
  labels: ["dependencies"],
  minimumReleaseAge: "3 days",
  // Many images (ghcr.io, the Docker Hub tags) carry no release date; without this they would wait
  // in "Pending Status Checks" for good instead of coming as a pull request
  minimumReleaseAgeBehaviour: "timestamp-optional",
  internalChecksFilter: "strict",
  // Renovate merges itself once the checks pass; GitHub's auto-merge is off in most repositories
  platformAutomerge: false,
  automergeType: "pr",
  // The helper workflows of some projects (engine-pin.yml, renovate-flatpak.yml, ...) commit a hash
  // or regenerated sources on Renovate's branch as github-actions[bot]; that keeps it Renovate's
  // branch, so it is still rebased and merged
  gitIgnoredAuthors: ["41898282+github-actions[bot]@users.noreply.github.com"],
  // Every pull request runs the whole CI (some with e2e shards): at most five open, two new ones an
  // hour, and a branch is rebased only when it conflicts, not on every push to main
  prConcurrentLimit: 5,
  prHourlyLimit: 2,
  rebaseWhen: "conflicted",
  lockFileMaintenance: {
    enabled: true,
    schedule: ["* 0-5 1 * *"],
    automerge: true,
  },
  vulnerabilityAlerts: {
    enabled: true,
    labels: ["dependencies", "security"],
    schedule: ["at any time"],
    minimumReleaseAge: null,
    automerge: false,
  },
  packageRules: [
    {
      // The ordinary packages: one PR a month, merged once CI is green
      matchUpdateTypes: ["minor", "patch", "pin", "digest"],
      groupName: "dependencies (minor and patch)",
      groupSlug: "minor-patch",
      schedule: ["* 0-5 1 * *"],
      automerge: true,
    },
    {
      // 0.x: a minor may break (semver), so these come in a PR of their own that waits for a person
      matchUpdateTypes: ["minor"],
      matchCurrentVersion: "/^v?0\\./",
      groupName: "dependencies (0.x minor)",
      groupSlug: "zero-minor",
      automerge: false,
    },
    {
      matchUpdateTypes: ["major"],
      dependencyDashboardApproval: true,
      automerge: false,
    },
    {
      // The majors of the ordinary packages in one pull request too, opened when ticked: one CI run
      // and one place to fix what breaks (a project's own rules keep theirs apart)
      matchUpdateTypes: ["major"],
      groupName: "dependencies (major)",
      groupSlug: "packages",
    },
    {
      // The majors of the workflows (actions, runner images, setup-* versions) in one pull request:
      // they rarely break and are checked by one CI run together
      matchManagers: ["github-actions"],
      matchUpdateTypes: ["major"],
      groupName: "GitHub Actions (major)",
      groupSlug: "actions",
    },
    {
      // The shared workflows and actions, moved by this repository's move-tag.yml
      matchPackageNames: ["firsttris/workflows", "firsttris/workflows/**"],
      enabled: false,
    },
  ],
}
